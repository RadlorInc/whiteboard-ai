  {
   "q": "What is the water cycle?",
   "els": {
    "title": "title | The water cycle",
    "sea": "sea 0 540 440",
    "sun": "sun 870 105 36",
    "vapour": "vapour 120 260 420 250 | Evaporation",
    "cond": "flow 340 236 486 168 c=sky | Condensation",
    "cloud": "cloud 610 140 1.5",
    "mountain": "mountain 780 545 420 260",
    "rain": "rain 520 200 630 300 | Precipitation",
    "coll": "flow 660 420 530 446 c=blue n=2 bend=-10 | Collection"
   },
   "steps": [
    {
     "say": "Step 1: Water on Earth is always on the move, in a giant loop called the water cycle.",
     "do": [
      "write title 1200",
      "draw sea 1400",
      "fill sea",
      "loop sea sway"
     ]
    },
    {
     "say": "Step 2: The sun warms the sea, and water rises into the air as invisible vapour. That is evaporation.",
     "do": [
      "draw vapour 1600",
      "loop vapour rise"
     ]
    },
    {
     "say": "Step 3: High up, the vapour cools into tiny droplets that gather into clouds. That is condensation.",
     "do": [
      "draw sun 800",
      "fill sun",
      "pop sun 1.15",
      "draw cond 900",
      "draw cloud 1200",
      "fill cloud",
      "pop cloud 1.12"
     ]
    },
    {
     "say": "Step 4: When the droplets get heavy, they fall as rain or snow. That is precipitation.",
     "do": [
      "draw mountain 1400",
      "fill mountain",
      "draw rain 900",
      "loop rain fall"
     ]
    },
    {
     "say": "Step 5: Rivers carry the water back to the sea, and the whole cycle starts again.",
     "do": [
      "draw coll 1000",
      "loop coll flow",
      "loop cond flow",
      "&travel vapour,cond,rain,coll 5200 loop",
      "wait 5400"
     ]
    }
   ]
  },
  {
   "q": "How does the heart pump blood?",
   "els": {
    "title": "title | The heart: a double pump",
    "heart": "heart 480 330 300",
    "bodyIn": "flow 90 300 318 300 c=blue n=2 | From the body",
    "toLungs": "flow 408 150 230 182 c=blue at=end | To the lungs",
    "fromLungs": "flow 870 300 642 300 c=red n=2 | From the lungs",
    "toBody": "flow 600 172 800 110 c=red at=end | To the body",
    "lbl1": "label 120 505 c=blue s=24 | Its right side → lungs",
    "lbl2": "label 610 505 c=red s=24 | Its left side → body"
   },
   "steps": [
    {
     "say": "Step 1: Your heart is a pump about the size of your fist, and it never stops.",
     "do": [
      "write title 1200",
      "draw heart 2600",
      "fill heart",
      "pop heart 1.1",
      "loop heart beat"
     ]
    },
    {
     "say": "Step 2: Used blood, low on oxygen, comes back from the body into its right side.",
     "do": [
      "draw bodyIn 1100",
      "loop bodyIn flow"
     ]
    },
    {
     "say": "Step 3: The right side pumps it to the lungs, where it picks up fresh oxygen.",
     "do": [
      "draw toLungs 1000",
      "loop toLungs flow"
     ]
    },
    {
     "say": "Step 4: Fresh blood comes back from the lungs into the left side.",
     "do": [
      "draw fromLungs 1100",
      "loop fromLungs flow"
     ]
    },
    {
     "say": "Step 5: And the strong left side pumps it out to the whole body. Two pumps beating together, about seventy times a minute.",
     "do": [
      "draw toBody 1000",
      "loop toBody flow",
      "&travel bodyIn,toLungs,fromLungs,toBody 6000 loop",
      "draw lbl1 700",
      "draw lbl2 700",
      "wait 4000"
     ]
    }
   ]
  }
 ],
