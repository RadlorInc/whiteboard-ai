# Every environment variable the app uses (PLAN.md §14). Copy to .env.local and fill in; values are blank on purpose.
# .env.local is git-ignored. Never put a key in any other file: `npm run lint:secrets` and the pre-commit hook fail on one.
# Local values come from `supabase status -o env` (the local stack) and from the "Local" column of §14.

# ---- Public (the only NEXT_PUBLIC_ ones; they reach the browser) ----
# Supabase API URL (local: http://127.0.0.1:55321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (local: PUBLISHABLE_KEY from `supabase status -o env`)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (local: Cloudflare's always-pass test site key; the secret goes in Supabase Auth's captcha config)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server only ----
# Supabase secret key: calls SECURITY DEFINER functions, Storage and the Auth admin API only; server-only modules (local: SECRET_KEY)
SUPABASE_SECRET_KEY=
# Anthropic key: optional locally (only with WB_LIVE=1, costs money); wb-staging on preview, wb-prod on production. Never printed or logged
ANTHROPIC_API_KEY=
# 1 = replay hand-made answers instead of calling the model. Local and tests only; must NOT exist in production (import-time guard)
GENERATION_MOCK=
# ElevenLabs voice: all three absent = the browser's voice. Not used locally
ELEVENLABS_API_KEY=
# ElevenLabs model id (D4: v4 Turbo if /with-timestamps returns timings, else Flash v2.5)
ELEVENLABS_MODEL_ID=
# ElevenLabs voice id
ELEVENLABS_VOICE_ID=
# Stripe secret key: optional rk_test_ locally, rk_test_ on preview, rk_live_ on production only (live key guard)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (local: whsec_local_only, or the one `stripe listen` prints)
STRIPE_WEBHOOK_SECRET=
# Stripe price ids of the plans: PLUS ($13.99, 70 videos) and PRO ($25.99, 150) are on sale; the per-level ones are old
# High school: Plus $9.99, Pro $19.99
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# College: $13.99, $25.99
STRIPE_PRICE_PLUS_COLLEGE=
STRIPE_PRICE_PRO_COLLEGE=
# Grad school: $13.99, $25.99
STRIPE_PRICE_PLUS_GRAD=
STRIPE_PRICE_PRO_GRAD=
# Packs: off sale since 20 Oct 2026; the ids stay so old purchases' webhooks still map
# Stripe price id of the 60-credit pack ($4.99)
STRIPE_PRICE_TOPUP_60=
# Stripe price id of the 132-credit pack ($9.99)
STRIPE_PRICE_TOPUP_132=
# Stripe price id of the 282-credit pack ($19.99)
STRIPE_PRICE_TOPUP_282=
# Stripe price ids of the packs on sale (22 Oct 2026): 20 videos $4.99, 45 $9.99, 100 $19.99
STRIPE_PRICE_TOPUP_20=
STRIPE_PRICE_TOPUP_45=
STRIPE_PRICE_TOPUP_100=
# 1 = plans, packs and buy buttons shown (set per environment once its Stripe keys and webhook work)
NEXT_PUBLIC_PLANS_ON=
# Optional Stripe Customer Portal configuration id
STRIPE_PORTAL_CONFIG=
# Stripe Tax switch (§8.9)
STRIPE_TAX=
# Radar value list of beta customers allowed past the US-card block (B14); not used locally
STRIPE_RADAR_BETA_LIST=
# Radar value list of blocked card fingerprints, filled on disputes (§8.6); not used locally
STRIPE_RADAR_BLOCKED_CARDS_LIST=
# The app's own origin, used for every link and redirect; never taken from the Host header (local: http://localhost:3100)
APP_URL=
# Bearer secret for /api/cron/*; unset = the cron routes fail closed
CRON_SECRET=
# 1 = keep each used style's cached prompt warm (production only)
KEEP_WARM=
# Resend key for email; not used locally (Mailpit catches local mail on port 55324)
RESEND_API_KEY=
# Where ops alerts go; never written in the repo; not used locally
OPS_ALERT_TO=
# 32 random bytes (e.g. `openssl rand -hex 32`): keys the rate-limit buckets
RATE_LIMIT_HMAC_KEY=
# 32 random bytes: signs the age-gate cookie
AGE_COOKIE_KEY=

# ---- GitHub Actions secrets only: never in any .env file, listed here so the list is complete ----
# VERCEL_DEPLOY_HOOK_PROD   deploy.yml calls it after CI passes on main
# PROD_DB_URL               migrate-prod.yml only, behind the production-db environment (the founder approves each run)
# STAGING_DB_URL            migrate-staging.yml only
# PROD_DB_READONLY_URL      backup.yml's read-only role
# BACKUP_AGE_RECIPIENT      the founder's public age key the nightly dump is encrypted to
# CRON_SECRET               also a GitHub secret, for smoke.yml
